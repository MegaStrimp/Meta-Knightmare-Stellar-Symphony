///@description MKSS - Room Setup - Starless Marx

function scr_MKSS_RoomSetup_StarlessMarx()
{
	#region Screen Setup
	global.gameWidthTarget = global.gameWidthDefault;
	global.gameHeightTarget = global.gameHeightDefault;
	#endregion
	
	#region Discord
	scr_Discord_Setup("VS. Starless Marx",-1,"icon",global.gameTitle,"strimp","From Strimp's Kitchen");
	#endregion
}