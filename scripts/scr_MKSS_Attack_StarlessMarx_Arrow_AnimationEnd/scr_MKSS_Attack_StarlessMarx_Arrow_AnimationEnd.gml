///@description MKSS - Attack - Starless Marx - Arrow - Animation End

function scr_MKSS_Attack_StarlessMarx_Arrow_AnimationEnd()
{
	if (sprite_index == spr_MKSS_Attack_StarlessMarx_Arrow2)
	{
		mask_index = spr_MKSS_Attack_StarlessMarx_Arrow2;
		imageSpeed = 0;
	}
	image_index = image_number - 1;
}